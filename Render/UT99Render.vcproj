<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="8.00"
	Name="UT99Render"
	ProjectGUID="{B1000012-0000-0000-0000-000000000012}"
	RootNamespace="UT99Render"
	>
	<Platforms>
		<Platform Name="Win32"/>
	</Platforms>
	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory="$(SolutionDir)build\debug\lib"
