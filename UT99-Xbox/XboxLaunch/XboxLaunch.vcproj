				Name="VCCLCompilerTool"
				AdditionalOptions="/MT /GS-"
				Optimization="0"
				AdditionalIncludeDirectories="C:\XDK\xbox\include;$(SolutionDir)XboxLaunch\Inc;$(SolutionDir)XboxDrv\Inc;$(SolutionDir)XboxRender\Inc;$(SolutionDir)XboxAudio\Inc;$(SolutionDir)XboxNet\Inc;..\..\Core\Inc;..\..\Engine\Inc;..\..\IpDrv\Inc"
				PreprocessorDefinitions="TARGET_XBOX=1;UNICODE_XBOX=1;_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_WARNINGS;WIN32;_DEBUG;_WINDOWS;_REALLY_WANT_DEBUG;ASM=0;ASM3DNOW=0;ASMKNI=0"
