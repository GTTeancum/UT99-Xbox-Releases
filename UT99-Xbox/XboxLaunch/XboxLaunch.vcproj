			<Tool
				Name="VCManagedResourceCompilerTool"
			/>
			<Tool
				Name="VCResourceCompilerTool"
			/>
			<Tool
				Name="VCPreLinkEventTool"
			/>
			<Tool
				Name="VCPostBuildEventTool"
				CommandLine="python &quot;$(SolutionDir)Tools\patchxbe.py&quot; &quot;$(OutDir)\UnrealTournament.exe&quot; &quot;$(OutDir)\default.xbe&quot;"
				Description="Building XBE..."
			/>
			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="/MACHINE:I386 /FIXED:NO /MERGE:.CRT=.data /SECTION:.data,RW"
				AdditionalDependencies="..\build\debug\lib\XboxStubs.lib ..\build\debug\lib\UT99Core.lib ..\build\debug\lib\UT99Engine.lib ..\build\debug\lib\UT99Render.lib ..\build\debug\lib\XboxDrv.lib ..\build\debug\lib\XboxRender.lib d3d8-xbox.lib xboxkrnl.lib xgraphicsd.lib xonlined.lib xactengd.lib xnetd.lib xapilibd.lib xbdm.lib s3tc.lib"
				OutputFile="$(OutDir)\UnrealTournament.exe"
				AdditionalLibraryDirectories="C:\XDK\lib;..\..\Engine\Lib"
				IgnoreAllDefaultLibraries="false"
				GenerateDebugInformation="true"
				MapFileName="$(OutDir)\UnrealTournament.map"
				GenerateMapFile="true"
				IgnoreSpecificLibrary="libc.lib"
				SubSystem="1"
			/>
			<Tool
				Name="VCALinkTool"
			/>
			<Tool
				Name="VCManifestTool"
			/>
