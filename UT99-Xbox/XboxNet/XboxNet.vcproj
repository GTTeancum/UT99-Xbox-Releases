<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="8.00"
	Name="XboxNet"
	ProjectGUID="{B1000005-0000-0000-0000-000000000005}"
	RootNamespace="XboxNet"
	Keyword="Win32Proj"
	>
	<Platforms>
		<Platform
			Name="Win32"
		/>
	</Platforms>
	<ToolFiles>
	</ToolFiles>
	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory="$(SolutionDir)build\debug\lib"
			IntermediateDirectory="$(SolutionDir)build\debug\obj\XboxNet"
			ConfigurationType="4"
			CharacterSet="2"
			>
			<Tool
				Name="VCCLCompilerTool"
				AdditionalOptions="/MT"
				Optimization="0"
				AdditionalIncludeDirectories="C:\XDK\xbox\include;$(SolutionDir)XboxNet\Inc;..\Core\Inc;..\Engine\Inc"
				PreprocessorDefinitions="TARGET_XBOX=1;_CRT_SECURE_NO_WARNINGS;WIN32;_DEBUG"
				BasicRuntimeChecks="0"
				RuntimeLibrary="0"
				UsePrecompiledHeader="0"
				WarningLevel="2"
				DebugInformationFormat="4"
				DisableSpecificWarnings="4996;4244;4267;4305;4800"
			/>
			<Tool
				Name="VCLibrarianTool"
				OutputFile="$(OutDir)\XboxNet.lib"
			/>
		</Configuration>
		<Configuration
			Name="Release|Win32"
			OutputDirectory="$(SolutionDir)build\release\lib"
			IntermediateDirectory="$(SolutionDir)build\release\obj\XboxNet"
			ConfigurationType="4"
			CharacterSet="2"
			>
			<Tool
				Name="VCCLCompilerTool"
				AdditionalOptions="/MT"
				Optimization="2"
				AdditionalIncludeDirectories="C:\XDK\xbox\include;$(SolutionDir)XboxNet\Inc;..\Core\Inc;..\Engine\Inc"
				PreprocessorDefinitions="TARGET_XBOX=1;_CRT_SECURE_NO_WARNINGS;WIN32;NDEBUG"
				RuntimeLibrary="0"
				UsePrecompiledHeader="0"
				WarningLevel="2"
				DebugInformationFormat="0"
				DisableSpecificWarnings="4996;4244;4267;4305;4800"
			/>
			<Tool
				Name="VCLibrarianTool"
				OutputFile="$(OutDir)\XboxAudio.lib"
			/>
		</Configuration>
	</Configurations>
	<References>
	</References>
	<Files>
		<Filter
			Name="Source"
			Filter="cpp;c"
			>
			<File
				RelativePath=".\Src\XboxNet.cpp"
			>
			</File>
		</Filter>
		<Filter
			Name="Headers"
			Filter="h"
			>
			<File
