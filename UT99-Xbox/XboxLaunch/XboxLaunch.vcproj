				BasicRuntimeChecks="0"
				RuntimeLibrary="0"
				UsePrecompiledHeader="0"
				WarningLevel="2"
				DebugInformationFormat="4"
				DisableSpecificWarnings="4996;4244;4267;4305;4013;4133;4114;4028;4800"
